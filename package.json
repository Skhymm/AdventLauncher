{
  "name": "adventmc-launcher",
  "version": "1.0.0",
  "description": "Лаунчер Advent MC - открытый мир, с элементами MMORPG в мире Майнкрафт!",
  "main": "main.js",
  "author": "Alexei Kurochkin, Ilya Klimov",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "minecraft-launcher-core": "^3.18.1",
    "minecraft-server-util": "^5.4.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.adventmc.launcher",
    "productName": "Advent MC Launcher",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "preload-installer.js",
      "config.json",
      "reg.txt",
      "renderer/**/*",
      "installer/**/*",
      "src/**/*",
      "mod/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "renderer/assets/icon.png"
    }
  }
}
